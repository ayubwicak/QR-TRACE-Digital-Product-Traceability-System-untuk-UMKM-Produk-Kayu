# Server Port Configuration
PORT=5000

# Public URL embedded in QR codes when creating them from localhost.
# Use the current public deployment or Cloudflare Tunnel URL.
VITE_PUBLIC_APP_URL=https://your-public-host.example.com

# PostgreSQL Database Connection URL
# Example: postgresql://username:password@localhost:5432/databasename
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrtrace

# Security Configurations
JWT_SECRET=super_secret_jwt_key_qrtrace_2026_change_in_production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
